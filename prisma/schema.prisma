// =============================================================================
// AI-Powered Opportunity Aggregator - Complete Database Schema
// Prisma 7.x Compatible Schema
// =============================================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // URL managed in prisma.config.ts per Prisma 7 best practices
}

